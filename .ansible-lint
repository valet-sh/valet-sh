---
skip_list:
  - "name[template]"
  - "name[casing]"
  - "name[missing]"
  - "no-changed-when"
  - "yaml[line-length]"
  - "yaml[new-line-at-end-of-file]"
  - "yaml[comments]"
  - "yaml[empty-lines]
  - "var-naming[non-string]"
  - "var-naming[no-role-prefix]"
  - "no-handler"
  - "latest[git]"
  - "ignore-errors"
  - "no-tabs"
  - "role-name"
  - "risky-shell-pipe"
  - "command-instead-of-module"
  - "command-instead-of-shell"
  - "key-order[task]"
  - "no-relative-paths"
  - "schema[tasks]"
  - "schema[vars]"
  - "risky-file-permissions"
