[Unit]
Description=Redis-Server for {{ current_service.canonical }}
After=network-online.target local-fs.target
Wants=network-online.target

[Service]
Type=exec
NotifyAccess=all
Restart=always
RestartSec=5s
TimeoutStartSec=0
TimeoutStopSec=30

ExecStart=/usr/bin/podman run \
    --replace \
    --rm \
    --name vsh-{{ current_service.canonical }} \
    --volume vsh-{{ current_service.canonical }}:/data \
    --volume {{ current_service.configuration.base_path }}/config/redis.conf:/etc/redis/redis.conf:Z \
    --network host \
    {{ current_service.configuration.docker_image }} redis-server /etc/redis/redis.conf
ExecReload=/usr/bin/podman restart vsh-{{ current_service.canonical }}
ExecStop=/usr/bin/podman stop --time 10 vsh-{{ current_service.canonical }}

[Install]
WantedBy=default.target
