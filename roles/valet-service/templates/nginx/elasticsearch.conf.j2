{{ ansible_managed | comment }}

{% for service_name in ['elasticsearch', 'opensearch'] %}
{% for version in valet_sh_bundle_definitions.services[service_name].versions %}
{% set bundle_file = valet_dist_path_default + '/roles/shared-variables/defaults/main' +'/bundles/' + service_name + '/' + version + '.yml' %}
{% set bundle = lookup('file', bundle_file) | from_yaml %}
upstream {{ service_name }}{{ version }} {
    server 127.0.0.1:{{ bundle.configuration.ports.http }};
}
{% endfor %}
{% endfor %}

server {
  listen    127.0.0.1:9200;

  location / {
    proxy_pass            http://{{ item.canonical }};
    proxy_read_timeout    90;
    proxy_connect_timeout 90;
    proxy_set_header      Host $host;
    proxy_set_header      X-Real-IP $remote_addr;
    proxy_set_header      X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header      Proxy "";
  }
}
