#!/bin/bash

AVAILABLE_REDIS_VERSIONS='{{ valet_sh_bundle_definitions.services.redis.versions | join(" ") }}'

function get_target_version {
    VALET_SH_FILE=$1

    SELECTED_REDIS_VERSION=$(/usr/local/valet-sh/venv/bin/shyaml get-value services.redis.version < "${VALET_SH_FILE}" 2>/dev/null)
   	# shellcheck disable=SC2181
    if [ $? -eq 0 ]
    then
      if [[ " $AVAILABLE_REDIS_VERSIONS " =~ .*\ $SELECTED_REDIS_VERSION\ .* ]]; then
         TARGET_EDITION=redis
         TARGET_VERSION=$SELECTED_REDIS_VERSION
         return 0
      fi
    fi
    return 1
}

if test -f ".valet-sh.yml"; then
  CURRENT_VALET_SH_FILE=".valet-sh.yml"
elif test -f "../.valet-sh.yml"; then
  CURRENT_VALET_SH_FILE="../.valet-sh.yml"
fi

if [[ $CURRENT_VALET_SH_FILE ]]
then
  get_target_version $CURRENT_VALET_SH_FILE
  # shellcheck disable=SC2181
  if [ $? -eq 0 ]
  then
    exec /usr/local/bin/"${TARGET_EDITION}${TARGET_VERSION}-cli" "$@"
  else
    exec /usr/local/bin/default-redis-cli "$@"
  fi
else
  exec /usr/local/bin/default-redis-cli "$@"
fi
