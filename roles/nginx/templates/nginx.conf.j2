{{ ansible_managed | comment }}

user {{ current_user }} {{ current_group }};
worker_processes auto;
pid {{ nginx_pid_path }};
include {{ valet_sh_prefix }}/etc/nginx/modules-enabled/*.conf;

events {
    worker_connections 768;
}

http {
    sendfile on;

    tcp_nopush on;
    tcp_nodelay on;

    keepalive_timeout 65;
    types_hash_max_size 2048;
    server_tokens off;

{% if current_os == "mac" %}
    http2 on;
{% endif %}

    client_max_body_size 128M;

    include {{ valet_sh_prefix }}/etc/nginx/mime.types;
    default_type application/octet-stream;

    ssl_session_cache  shared:SSL:10m;
    ssl_session_timeout  5m;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers "EECDH+AESGCM:EDH+AESGCM:AES256+EECDH:AES256+EDH";
    ssl_ecdh_curve secp384r1;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;
    ssl_prefer_server_ciphers on;
    ssl_dhparam {{ nginx_dhparams_file }};

    access_log {{ valet_sh_prefix }}/var/log/nginx/access.log;
    error_log {{ valet_sh_prefix }}/var/log/nginx/error.log;

{% if current_os == 'mac' %}
    resolver 127.0.0.1:2053 valid=10s ipv6=off;
{% elif current_os == 'ubuntu' and os_codename == "resolute" %}
    resolver 127.0.0.1:5353 valid=10s ipv6=off;
{% else %}
    resolver 127.0.1.1:53 valid=10s ipv6=off;
{% endif %}

    gzip on;
    gzip_disable "msie6";
    gzip_vary on;
    gzip_comp_level 8;
    gzip_min_length  1100;
    gzip_buffers 16 8k;
    gzip_proxied any;
    gzip_http_version 1.1;
    gzip_types  text/plain
                application/xml
                text/css
                text/js
                text/xml
                application/x-javascript
                text/javascript
                application/json
                application/xml+rss
                image/svg+xml
                application/javascript;

{% for php_version in valet_sh_bundle_definitions.services.php.versions %}
{% set php_bundle_file = valet_dist_path_default + '/roles/shared-variables/defaults/main/bundles/php/' + php_version + '.yml' %}
{% set php_bundle = lookup('file', php_bundle_file) | from_yaml %}
{% set php_socket = ('/var/run/php/' + php_bundle.service.name.ubuntu + '.sock') if current_os == 'ubuntu' else ('/tmp/' + php_bundle.service.name.mac + '.sock') %}
    upstream php{{ php_version | replace('.', '') }} {
        server unix:{{ php_socket }};
    }
{% endfor %}

    include {{ valet_sh_prefix }}/etc/nginx/conf.d/*.conf;
}

stream {

{% if current_os == 'mac' %}
    resolver 127.0.0.1:2053 valid=10s ipv6=off;
{% elif current_os == 'ubuntu' and os_codename == "resolute" %}
    resolver 127.0.0.1:5353 valid=10s ipv6=off;
{% else %}
    resolver 127.0.1.1:53 valid=10s ipv6=off;
{% endif %}

    include {{ valet_sh_prefix }}/etc/nginx/stream.d/*.conf;
}

