Neos:
  Flow:
    persistence:
      backendOptions:
        driver: pdo_mysql
        dbname: "{{ valet_sh_neos_db_name }}"
        user: "root"
        password: "root"
        host: {{ '127.0.0.1' if current_os == 'ubuntu' else database_service.services[0].service.name + '.vsh' }}:{{ valet_sh_neos_db_port }}
    core:
      phpBinaryPathAndFilename: {{ php_bin }}
{% if valet_sh_neos_search_engine_version is defined  %}
  ContentRepository:
    Search:
      elasticSearch:
        indexName: {{ valet_sh_project_vars.instance.key }}
Flowpack:
  ElasticSearch:
    clients:
        default:
            - host: {{ '127.0.0.1' if current_os == 'ubuntu' else search_engine_service.services[0].service.name + '.vsh' }}
              port: {{ search_engine_service.services[0].configuration.ports.http }}
    indexes:
      default:
        {{ valet_sh_project_vars.instance.key }}:
          settings:
            index:
              number_of_shards: 1
              number_of_replicas: 0
{% endif %}
