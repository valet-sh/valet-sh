[Unit]
Description=Rabbitmq-Server
After=network-online.target local-fs.target
Wants=network-online.target

[Service]
Type=exec
NotifyAccess=all
Restart=always
RestartSec=5s
TimeoutStartSec=0
TimeoutStopSec=30

ExecStart=/usr/bin/podman run \
    --replace \
    --rm \
    --name vsh-{{ current_service.canonical }} \
    --volume vsh-{{ current_service.canonical }}:/var/lib/rabbitmq \
    --volume {{ current_service.configuration.base_path }}/config/rabbitmq.conf:/etc/rabbitmq/rabbitmq.conf:Z \
    --volume {{ current_service.configuration.base_path }}/config/enabled_plugins:/etc/rabbitmq/enabled_plugins:Z \
    --network host \
    --hostname {{ current_service.service.name }} \
    --add-host {{ current_service.service.name }}:127.0.0.1 \
    --env "RABBITMQ_NODE_PORT={{ current_service.configuration.ports.amqp }}" \
    --env "RABBITMQ_NODENAME={{ current_service.canonical }}@localhost" \
    --env ERL_EPMD_ADDRESS=127.0.0.1 \
    --env ERL_EPMD_PORT={{ current_service.configuration.ports.amqp|int - 1303 }} \
    --env RABBITMQ_SERVER_ADDITIONAL_ERL_ARGS="-kernel inet_dist_listen_min 25673 inet_dist_listen_max 25673" \
    {{ current_service.configuration.docker_image }}
ExecReload=/usr/bin/podman restart vsh-{{ current_service.canonical }}
ExecStop=/usr/bin/podman stop --time 10 vsh-{{ current_service.canonical }}

[Install]
WantedBy=default.target
