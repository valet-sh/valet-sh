#!/bin/bash

CONTAINER="vsh-{{ current_service.canonical }}"

args=()
skip_next=0
for arg in "$@"; do
    if [[ $skip_next -eq 1 ]]; then
        skip_next=0
        continue
    fi
    case "$arg" in
        --defaults-file=*)
            continue
            ;;
        -h|--host|-P|--port)
            skip_next=1
            continue
            ;;
        -h*|-P*|--host=*|--port=*)
            continue
            ;;
    esac
    args+=("$arg")
done

{% if current_os == 'ubuntu' %}
if ! podman inspect "$CONTAINER" 2>/dev/null | grep -q '"running"'; then
    echo "Error: $CONTAINER is not running" >&2
    exit 1
fi
TTY_FLAG=""; [ -t 0 ] && TTY_FLAG="-t"
{% if current_service.version | float >= 11.4 %}
exec podman exec -i $TTY_FLAG "$CONTAINER" mariadb --defaults-file=/root/.my.cnf "${args[@]}"
{% else %}
exec podman exec -i $TTY_FLAG "$CONTAINER" mysql --defaults-file=/root/.my.cnf "${args[@]}"
{% endif %}
{% else %}
if ! container inspect "$CONTAINER" 2>/dev/null | grep -q '"running"'; then
    echo "Error: $CONTAINER is not running" >&2
    exit 1
fi
TTY_FLAG=""; [ -t 0 ] && TTY_FLAG="-t"
{% if current_service.version | float >= 11.4 %}
exec container exec -i $TTY_FLAG "$CONTAINER" mariadb --defaults-file=/home/.my.cnf "${args[@]}"
{% else %}
exec container exec -i $TTY_FLAG "$CONTAINER" mysql --defaults-file=/home/.my.cnf "${args[@]}"
{% endif %}
{% endif %}
