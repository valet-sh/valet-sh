#!/bin/bash

CONTAINER="vsh-{{ current_service.canonical }}"

{% if current_os == 'ubuntu' %}
if ! podman inspect "$CONTAINER" 2>/dev/null | grep -q '"running"'; then
    echo "Error: $CONTAINER is not running" >&2
    exit 1
fi
TTY_FLAG=""; [ -t 0 ] && TTY_FLAG="-t"
{% if current_service.version | float >= 11.4 %}
exec podman exec -i $TTY_FLAG "$CONTAINER" mariadb --defaults-file=/root/.my.cnf "$@"
{% else %}
exec podman exec -i $TTY_FLAG "$CONTAINER" mysql --defaults-file=/root/.my.cnf "$@"
{% endif %}
{% else %}
if ! container inspect "$CONTAINER" 2>/dev/null | grep -q '"running"'; then
    echo "Error: $CONTAINER is not running" >&2
    exit 1
fi
TTY_FLAG=""; [ -t 0 ] && TTY_FLAG="-t"
{% if current_service.version | float >= 11.4 %}
exec container exec -i $TTY_FLAG "$CONTAINER" mariadb --defaults-file=/home/.my.cnf "$@"
{% else %}
exec container exec -i $TTY_FLAG "$CONTAINER" mysql --defaults-file=/home/.my.cnf "$@"
{% endif %}
{% endif %}
