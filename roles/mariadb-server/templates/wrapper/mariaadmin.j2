#!/bin/bash

CONTAINER="vsh-{{ current_service.canonical }}"

args=()
for arg in "$@"; do
    [[ "$arg" == --defaults-file=* ]] || args+=("$arg")
done

{% if current_os == 'ubuntu' %}
if ! podman inspect "$CONTAINER" 2>/dev/null | grep -q '"running"'; then
    echo "Error: $CONTAINER is not running" >&2
    exit 1
fi
TTY_FLAG=""; [ -t 0 ] && TTY_FLAG="-t"
{% if current_service.version | float >= 11.4 %}
exec podman exec -i $TTY_FLAG "$CONTAINER" mariadb-admin --defaults-file=/root/.my.cnf "${args[@]}"
{% else %}
exec podman exec -i $TTY_FLAG "$CONTAINER" mysqladmin --defaults-file=/root/.my.cnf "${args[@]}"
{% endif %}
{% else %}
if ! container inspect "$CONTAINER" 2>/dev/null | grep -q '"running"'; then
    echo "Error: $CONTAINER is not running" >&2
    exit 1
fi
TTY_FLAG=""; [ -t 0 ] && TTY_FLAG="-t"
{% if current_service.version | float >= 11.4 %}
exec container exec -i $TTY_FLAG "$CONTAINER" mariadb-admin --defaults-file=/home/.my.cnf "${args[@]}"
{% else %}
exec container exec -i $TTY_FLAG "$CONTAINER" mysqladmin --defaults-file=/home/.my.cnf "${args[@]}"
{% endif %}
{% endif %}
